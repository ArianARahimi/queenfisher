// Windows resources: icon, version details (shown under Properties > Details) and the manifest.
#include <winver.h>

IDI_ICON1 ICON "@ICON_PATH@"
1 24 "@MANIFEST_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Composer Software"
            VALUE "FileDescription", "Queenfisher media downloader"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Queenfisher"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "Queenfisher.exe"
            VALUE "ProductName", "Queenfisher"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
